.{
    // 程序运行结束后是否暂停等待用户按键再退出。
    // 在终端中直接双击运行时建议设为 true，避免窗口一闪而过；
    // 从已有终端中启动时设为 false 更顺手。
    .pause_after_finish = true,

    // 并发工作线程数 —— 同时处理多少个文件。
    // 数值越大吞吐越高，但也会消耗更多 CPU 和内存。
    // 可根据机器的核心数酌情调整（通常设为 CPU 逻辑核心数左右）。
    .worker_count = 5,

    // 刮削结果的输出子目录结构（全局配置，对下面每个 source 的 to 目录生效）。
    // 数组的每个元素对应一层子目录；以 "." 开头的元素是元数据占位符，
    // 刮削完成后会被对应元数据替换，缺失时省略该层。
    // 支持的占位符：
    //   .title         标题
    //   .originalTitle 原名
    //   .id            番号
    //   .studio        制作商
    //   .director      导演
    //   .premiered     发行日期
    //   .plot          简介
    //   .country       国家（cn/jp/us）
    //   .rating        评分（保留一位小数）
    //   .actress       第一位女优
    // 此数组不能为空（至少一个元素）。
    // 例如 .{ "hello", ".title", ".id", "1" } 会输出到 to/hello/<标题>/<番号>/1。
    // 只写 .{ ".id" } 时保持原来的按番号建目录的行为。
    .subdirs = .{ ".id" },

    // 每个源是一个独立的扫描目标，程序会遍历所有源并汇总结果。
    // 可按需添加多个源（例如：本地磁盘 + 移动硬盘）。
    .sources = .{
        .{
            // 源类别
            // ┌────────┬────────────────────────────────────────────────────────────────┐
            // │ 类别   │ 说明                                                           │
            // ├────────┼────────────────────────────────────────────────────────────────┤
            // │ .local │ 本地文件系统 —— 扫描 from 目录下的视频文件，处理后写入 to 目录 │
            // └────────┴────────────────────────────────────────────────────────────────┘
            .type = .local,

            // 输入目录 —— 从哪里读取源文件（必须是绝对路径）
            // 例如："/Volumes/Media/Raw" 或 "C:\Users\Me\Videos"
            .from = "",

            // 输出目录 —— 处理后的文件写到哪里（必须是绝对路径）
            .to = "",

            // 哪些扩展名后缀应该被识别为视频文件并纳入处理。
            // 匹配时不区分大小写。
            .exts = .{ "mp4", "avi", "mov", "m4v", "mkv", "flv", "rmvb", "wmv" },
        },
    },
}
