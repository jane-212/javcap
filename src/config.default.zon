.{
    // 程序是否在结束时暂停
    .pause_after_finish = true,
    .sources = .{
        .{
            // 源类型
            // .local -> 本地
            .type = .local,
            // 输入文件目录 使用绝对路径
            .from = "",
            // 输出文件目录 使用绝对路径
            .to = "",
            // 哪些扩展名应该被当作视频
            .exts = .{ "mp4", "avi", "mov", "m4v", "mkv", "flv", "rmvb", "wmv" },
        },
    },
}
